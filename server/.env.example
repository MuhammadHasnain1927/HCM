# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /hcm-lite
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/hcm-lite?retryWrites=true&w=majority

# Optional: separate database for automated tests (must end in "-test"; it is wiped on every run).
# If empty, tests start a temporary in-memory MongoDB instead.
TEST_MONGODB_URI=

# Long random string (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_URL=http://localhost:5173

# Optional: create the company and first Admin automatically on first start.
# Leave empty to use the first-run setup screen instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
COMPANY_NAME=

# AI providers. Server-side only; the browser never sees these.
# Gemini is tried first (default gemini-3.5-flash, then Flash-Lite); on quota, overload
# or timeout the same request goes to Groq (default openai/gpt-oss-120b).
# Leave the *_MODEL values empty to use the defaults.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
